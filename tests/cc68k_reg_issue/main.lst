0014                        short (*init)(struct s_dev_block *);        									// Initialize the device
0015                        short (*read)(struct s_dev_block *, long lba, uint8_t * buffer, short size);	// Read a block from the device
0016                        short (*write)(struct s_dev_block *, long lba, const uint8_t * buffer, short size);	// Write a block to the device
0017                        short (*status)(struct s_dev_block *);      									// Get the status of the device
0018                        short (*flush)(struct s_dev_block *);      										// Ensure that any pending writes to the device have been completed
0019                        short (*ioctrl)(struct s_dev_block *, short command, unsigned char * buffer, short size);	// Issue a control command to the device
0020                    } t_dev_block, *p_dev_block;
